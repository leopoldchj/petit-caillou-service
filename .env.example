# Copy this file to .env and fill in the real values.
# .env stays out of version control.

# Database connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=petit_caillou
DB_USERNAME=petit_caillou
DB_PASSWORD=
# disable, trust, verify-ca or verify-full. Use verify-full whenever the
# server accepts TLS: anything less sends credentials in clear.
DB_SSL_MODE=verify-full

# HTTP port exposed by the service.
# The web application reaches the API through a reverse proxy, so both sides
# share a single browser origin and no CORS configuration is needed.
SERVER_PORT=8080
